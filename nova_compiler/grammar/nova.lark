// ============================================================================
// NOVA DSL grammar — multilingual business-intent language.
// Every block/type keyword exists in French, English, Spanish, German,
// Italian and Portuguese; every spelling compiles to the exact same AST
// node, so a .nova file can freely mix languages.
// ============================================================================

start: statement*

statement: app_decl
         | entity_decl
         | api_decl
         | page_decl
         | auth_decl
         | query_decl
         | chart_decl
         | email_decl
         | calendar_decl
         | translations_decl
         | validation_decl

// ---------------------------------------------------------------- app -----
// Optional single block describing the application itself.
app_decl: APP_KW NAME "{" app_member* "}"
app_member: app_prop
          | languages_prop
app_prop: PROP_NAME ":" value
// `langues: fr, en` : liste de codes de langue séparés par des virgules,
// restreignant les langues actives du projet (voir ast_nodes.App.languages)
// — non-terminal dédié plutôt que le `value` générique de `app_prop` (même
// raison que `chart_value`/`query_prop.or_filter` : `value` ne supporte pas
// une liste, et le réutiliser tel quel casserait le lexer contextuel
// ailleurs, comme documenté sur `chart_prop` plus bas).
languages_prop: LANGUES_KW ":" NAME ("," NAME)*

// ------------------------------------------------------------- entity -----
entity_decl: ENTITY_KW NAME "{" entity_member* "}"
entity_member: field_decl
             | relation_decl
field_decl: FIELD_KW NAME ":" type_ref modifier*
modifier: REQUIRED_KW
        | UNIQUE_KW
        | DEFAULT_KW "=" value
        | PATTERN_KW "=" STRING
        | MULTILINGUAL_KW
type_ref: TYPE_STRING
        | TYPE_TEXT
        | TYPE_INT
        | TYPE_FLOAT
        | TYPE_BOOL
        | TYPE_DATE
        | TYPE_DATETIME
        | TYPE_FILE
        | TYPE_IMAGE
        | TYPE_COLOR
        | NAME                 // reference to another entity (relation by field)
relation_decl: HAS_MANY_KW NAME
             | BELONGS_TO_KW NAME

// ---------------------------------------------------------------- api -----
api_decl: API_KW NAME "{" api_member* "}"
api_member: api_action
          | protect_stmt
          | notify_stmt
          | notify_recipient_stmt
          | notify_attachment_stmt
api_action: LIST_KW | CREATE_KW | UPDATE_KW | DELETE_KW | GET_KW
protect_stmt: PROTECT_KW ":" NAME
// `notifier: creer, supprimer` (alias `notify: create, delete`...) : envoie
// un email (voir bloc `email { ... }` plus bas) après chaque action listée.
// Restreint volontairement à create/update/delete (des NOM d'action déjà
// définis pour `api_action`, réutilisés tels quels) : notifier sur une
// lecture (list/get) n'a pas de sens.
notify_stmt: NOTIFIER_KW ":" notify_action ("," notify_action)*
notify_action: CREATE_KW | UPDATE_KW | DELETE_KW
// `destinataire: <champ>` (alias `recipient:`...) : au lieu du destinataire
// fixe du bloc `email { destinataire: ... }`/NOVA_SMTP_TO, envoie à
// l'adresse contenue dans ce champ de l'ENREGISTREMENT concerné (ex. un
// champ `email: chaine` sur l'entité) — résolu/validé au moment de la
// génération (le champ doit exister sur l'entité, voir
// parser.py::_validate_notifiers), pas ici.
notify_recipient_stmt: DESTINATAIRE_KW ":" NAME
// `piece_jointe: <champ>` (alias `attachment:`...) : joint le fichier
// référencé par ce champ `file`/`image` de l'enregistrement à la
// notification — même résolution/validation que `notify_recipient_stmt`.
notify_attachment_stmt: PIECE_JOINTE_KW ":" NAME

// --------------------------------------------------------------- page -----
page_decl: PAGE_KW NAME "{" page_stmt* "}"
// `titre`/`title` accepte soit une chaîne littérale (affichée telle quelle
// dans toutes les langues, comportement historique inchangé), soit une clé
// nue référençant une entrée du bloc `traductions { ... }` (voir plus bas)
// — résolue au moment de la génération (`title_value`), pas ici.
page_stmt: SHOW_KW NAME (AS_KW display_mode)? (TITLE_KW title_value)? style_block?
display_mode: TABLE_KW | FORM_KW | CARD_KW
title_value: STRING | NAME
style_block: STYLE_KW "{" style_prop* "}"
style_prop: NAME ":" STRING

// --------------------------------------------------------------- auth -----
// Bloc optionnel unique : active l'authentification JWT + rôles pour tout
// le projet généré (backend + page de connexion Reflex).
auth_decl: AUTH_KW "{" auth_prop* "}"
auth_prop: ROLES_KW ":" name_list
         | DEFAULT_ROLE_KW ":" NAME
name_list: NAME ("," NAME)*

// -------------------------------------------------------------- query -----
// Requête déclarative au-delà du CRUD simple : filtre/tri/limite sur une
// entité, compilée en une route API dédiée (pas de SQL à écrire pour les
// cas courants). Plusieurs `filtre:` au premier niveau sont combinés par ET
// (comportement historique, inchangé) ; un bloc `ou: { filtre: ... filtre:
// ... }` regroupe des filtres combinés par OU entre eux, le groupe entier
// étant lui-même combiné par ET avec le reste (plusieurs blocs `ou:`
// possibles, chacun un groupe ET-é séparément) — voir _generate_query_router
// dans codegen/api_fastapi.py pour la traduction SQLAlchemy
// (`and_(*filtres, or_(*groupe1), or_(*groupe2), ...)`).
query_decl: QUERY_KW NAME SUR_KW NAME "{" query_prop* "}"
query_prop: FILTRE_KW ":" NAME COMPARATOR value
          | OU_KW ":" "{" or_filter+ "}"
          | TRIER_KW ":" NAME (ASC_KW | DESC_KW)?
          | LIMITE_KW ":" NUMBER
or_filter: FILTRE_KW ":" NAME COMPARATOR value

value: STRING | NUMBER | BOOL_TRUE | BOOL_FALSE | NAME

// --------------------------------------------------------- validation -----
// Validation croisant plusieurs champs d'une même entité (au-delà des
// contraintes portées par un `modifier` sur UN SEUL `field_decl` —
// requis/unique/motif/default) : une ou plusieurs règles comparant deux
// champs entre eux, chacune avec son propre message d'erreur, appliquées à
// la création ET à la modification (voir
// codegen/api_fastapi.py::_validation_check_lines). `regle`/`message` sont
// couplés dans UNE SEULE règle plutôt que déclarés séparément : sans ça,
// plusieurs `regle:`/`message:` dans le même bloc ne permettraient pas de
// savoir quel message va avec quelle règle.
validation_decl: VALIDATION_KW NAME SUR_KW NAME "{" validation_rule+ "}"
validation_rule: REGLE_KW ":" NAME COMPARATOR NAME MESSAGE_KW ":" STRING

// -------------------------------------------------------------- chart -----
// Graphique déclaratif : `sur <NAME>` référence soit une entité (les
// données viennent alors de son API liste), soit un bloc `requete`/`query`
// déjà déclaré (données filtrées/triées) — résolu au moment de la
// génération, pas ici. Les propriétés (`type`, `axe_x`, `axe_y`, `titre`)
// sont des NAME libres résolues via `keywords.CHART_PROP_ALIASES`, comme le
// bloc `style`, plutôt que des mots-clés dédiés dans la grammaire.
// NB : `chart_prop` utilise volontairement un non-terminal dédié
// (`chart_value`) plutôt que le `value` générique utilisé par app_prop/
// query_prop : le réutiliser ici créait un conflit LALR qui corrompait le
// lexer contextuel ailleurs dans la grammaire (ex. `app { description: "x" }`
// cessait de se parser) — bug réel rencontré et corrigé pendant le
// développement de ce bloc `chart`.
chart_decl: CHART_KW NAME SUR_KW NAME "{" chart_prop* "}"
chart_prop: NAME ":" chart_value
// `axe_y`/`y` accepte une liste de NAME séparés par des virgules pour les
// graphiques multi-séries (`axe_y: ventes, couts`) ; les autres propriétés
// (`type`, `axe_x`, `titre`) n'utilisent jamais qu'un seul token, mais
// partagent ce même non-terminal — aucune ambiguïté, la liste à un seul
// élément est simplement le cas usuel.
chart_value: STRING | NAME ("," NAME)*

// -------------------------------------------------------------- email -----
// Bloc optionnel unique : configuration SMTP pour les notifications
// déclenchées par `notifier:` sur un bloc `api` (voir ci-dessus). Comme
// `chart`, les propriétés (`hote`/`host`, `port`, `utilisateur`/`user`,
// `expediteur`/`from`, `destinataire`/`to`, `tls`) sont des NAME libres
// résolues via `keywords.EMAIL_PROP_ALIASES`, pas des terminaux dédiés par
// langue. `email_value` est un non-terminal dédié (pas le `value` générique
// partagé par `app_prop`/`query_prop`) pour la même raison que `chart_value`
// — voir le commentaire au-dessus de `chart_prop`. Le mot de passe SMTP
// n'est volontairement PAS un mot-clé de ce bloc : jamais de secret en
// clair dans le fichier .nova, toujours fourni au runtime via la variable
// d'environnement NOVA_SMTP_PASSWORD (voir codegen/api_fastapi.py).
email_decl: EMAIL_KW "{" email_prop* "}"
email_prop: NAME ":" email_value
email_value: STRING | NUMBER | BOOL_TRUE | BOOL_FALSE | NAME

// ------------------------------------------------------------ calendar -----
// Calendrier déclaratif : `sur <NAME>` référence une entité (vue mensuelle
// des enregistrements dont un champ date/date_heure tombe dans le mois
// affiché). Comme `chart`/`email`, les propriétés (`champ_date`/`date_field`,
// `champ_titre`/`title_field`) sont des NAME libres résolues via
// `keywords.CALENDAR_PROP_ALIASES`, pas des terminaux dédiés par langue.
// `calendar_value` est un non-terminal dédié (pas le `value` générique) pour
// la même raison que `chart_value`/`email_value` — voir le commentaire
// au-dessus de `chart_prop`.
calendar_decl: CALENDAR_KW NAME SUR_KW NAME "{" calendar_prop* "}"
calendar_prop: NAME ":" calendar_value
calendar_value: STRING | NAME

// -------------------------------------------------------------- i18n -----
// Bloc optionnel (répétable) `traductions { cle: { fr: "..." en: "..." ... } }` :
// textes d'interface (titres de page, etc.) déclarés une fois par clé et
// traduits dans les 6 langues, référencés ailleurs dans le fichier par leur
// clé nue (voir `title_value` ci-dessus) plutôt qu'écrits en dur. Les codes
// de langue (`fr`/`en`/`es`/`de`/`it`/`pt`) sont, comme pour `chart`/`email`/
// `calendar`, des NAME libres validés en Python (`keywords.LANG_CODES`) et
// non des terminaux Lark dédiés par langue — même raison que `chart_value` :
// voir le commentaire au-dessus de `chart_prop`.
translations_decl: TRANSLATIONS_KW "{" translation_entry* "}"
translation_entry: NAME "{" lang_prop* "}"
lang_prop: NAME ":" STRING

// ================================================== multilingual terminals ===
APP_KW: "app" | "application" | "aplicacion" | "aplicación" | "anwendung" | "applicazione" | "aplicacao" | "aplicação"
ENTITY_KW: "entity" | "entité" | "entite" | "entidad" | "entitaet" | "entität" | "entita" | "entità" | "entidade"
FIELD_KW: "field" | "champ" | "campo" | "feld"
REQUIRED_KW: "required" | "requis" | "requerido" | "obligatorio" | "erforderlich" | "richiesto" | "obbligatorio" | "obrigatorio" | "obrigatório"
UNIQUE_KW: "unique" | "unico" | "único" | "eindeutig"
DEFAULT_KW: "default" | "defaut" | "défaut" | "par_defaut" | "par_défaut" | "predeterminado" | "por_defecto" | "standard" | "predefinito" | "padrao" | "padrão"
PATTERN_KW: "pattern" | "motif" | "regex" | "patron" | "patrón" | "muster" | "modello" | "formato"
MULTILINGUAL_KW: "multilingual" | "multilingue" | "multilingüe" | "mehrsprachig" | "multilingua" | "multilíngue"
HAS_MANY_KW: "has_many" | "possede_plusieurs" | "possède_plusieurs" | "tiene_muchos" | "hat_viele" | "ha_molti" | "tem_muitos"
BELONGS_TO_KW: "belongs_to" | "appartient_a" | "appartient_à" | "pertenece_a" | "gehoert_zu" | "gehört_zu" | "appartiene_a" | "pertence_a"

API_KW: "api"
LIST_KW: "list" | "liste" | "listar" | "lista" | "elenco" | "auflisten"
CREATE_KW: "create" | "creer" | "créer" | "crear" | "erstellen" | "creare" | "criar"
UPDATE_KW: "update" | "modifier" | "mettre_a_jour" | "mettre_à_jour" | "actualizar" | "aktualisieren" | "aggiornare" | "atualizar"
DELETE_KW: "delete" | "supprimer" | "eliminar" | "borrar" | "loeschen" | "löschen" | "eliminare" | "excluir"
GET_KW: "get" | "obtenir" | "lire" | "obtener" | "erhalten" | "holen" | "ottenere" | "obter"
PROTECT_KW: "proteger" | "protect" | "protéger" | "proteggere" | "schuetzen" | "schützen"
NOTIFIER_KW: "notifier" | "notify" | "notificar" | "benachrichtigen" | "notificare"
DESTINATAIRE_KW: "destinataire" | "recipient" | "destinatario" | "empfaenger" | "empfänger"
PIECE_JOINTE_KW: "piece_jointe" | "pièce_jointe" | "attachment" | "adjunto" | "allegato" | "anexo" | "anhang"

PAGE_KW: "page" | "pagina" | "página" | "seite"
SHOW_KW: "show" | "afficher" | "mostrar" | "zeigen" | "anzeigen" | "mostrare" | "exibir"
AS_KW: "as" | "comme" | "como" | "als" | "come"
TITLE_KW: "title" | "titre" | "titulo" | "título" | "titel" | "titolo"
TABLE_KW: "table" | "tabla" | "tabelle" | "tabella" | "tabela"
FORM_KW: "form" | "formulaire" | "formulario" | "formulário" | "formular" | "modulo"
CARD_KW: "card" | "carte" | "tarjeta" | "karte" | "scheda" | "cartao" | "cartão"
STYLE_KW: "style" | "css" | "estilo" | "stil" | "stile"

AUTH_KW: "auth" | "authentification" | "authentication" | "autenticacion" | "autenticación" | "authentifizierung" | "autenticazione" | "autenticacao" | "autenticação"
ROLES_KW: "roles" | "rôles" | "rollen" | "ruoli" | "papeis" | "papéis"
DEFAULT_ROLE_KW: "role_par_defaut" | "role_par_défaut" | "default_role" | "rol_por_defecto" | "standardrolle" | "ruolo_predefinito" | "papel_padrao" | "papel_padrão"

CHART_KW: "chart" | "graphique" | "grafico" | "gráfico" | "diagramm"

EMAIL_KW: "email" | "courriel" | "correo" | "correio"

CALENDAR_KW: "calendar" | "calendrier" | "calendario" | "calendário" | "kalender"

TRANSLATIONS_KW: "translations" | "traductions" | "traducciones" | "übersetzungen" | "traduzioni" | "traduções"

QUERY_KW: "requete" | "requête" | "query" | "consulta" | "abfrage" | "interrogazione"
SUR_KW: "sur" | "on" | "from" | "en" | "von" | "su" | "em"
FILTRE_KW: "filtre" | "filter" | "filtro"
OU_KW: "ou" | "or" | "oder" | "o"
TRIER_KW: "trier_par" | "sort_by" | "order_by" | "ordenar_por" | "sortieren_nach" | "ordina_per"
ASC_KW: "asc" | "croissant" | "ascendente" | "aufsteigend" | "crescente"
DESC_KW: "desc" | "décroissant" | "decroissant" | "descendente" | "absteigend" | "decrescente"
LIMITE_KW: "limite" | "limit" | "límite"
COMPARATOR: ">=" | "<=" | "==" | "!=" | ">" | "<"

VALIDATION_KW: "validation" | "validación" | "validierung" | "convalida" | "validazione" | "validação"
REGLE_KW: "regle" | "règle" | "rule" | "regla" | "regel" | "regola" | "regra"
MESSAGE_KW: "message" | "mensaje" | "nachricht" | "messaggio" | "mensagem"

TYPE_STRING: "string" | "chaine" | "chaîne" | "cadena" | "zeichenkette" | "stringa" | "cadeia"
TYPE_TEXT: "text" | "texte" | "texto" | "testo"
TYPE_INT: "int" | "integer" | "entier" | "entero" | "ganzzahl" | "intero" | "inteiro"
TYPE_FLOAT: "float" | "decimal" | "décimal" | "flotante" | "gleitkomma" | "decimale"
TYPE_BOOL: "bool" | "boolean" | "booleen" | "booléen" | "booleano" | "boolesch"
TYPE_DATE: "date" | "fecha" | "datum" | "data"
TYPE_DATETIME: "datetime" | "date_heure" | "fecha_hora" | "datum_zeit" | "data_ora" | "data_hora"
TYPE_FILE: "file" | "fichier" | "archivo" | "datei" | "arquivo"
TYPE_IMAGE: "image" | "imagen" | "bild" | "immagine" | "imagem"
TYPE_COLOR: "color" | "couleur" | "farbe" | "colore" | "cor"

BOOL_TRUE: "true" | "vrai" | "verdadero" | "wahr" | "vero" | "verdadeiro"
BOOL_FALSE: "false" | "faux" | "falso" | "falsch"

PROP_NAME: "name" | "nom" | "description" | "lang" | "langue" | "version"
         | "nombre" | "nome" | "descripcion" | "descripción" | "beschreibung" | "descrizione"
         | "descricao" | "descrição" | "idioma" | "lingua" | "sprache"
         | "css" | "feuille_style" | "stylesheet"
         | "database" | "base_donnees" | "base_données" | "base_datos" | "datenbank" | "banco_dados"

// Priorité explicite (> défaut 0) : sans elle, le lexer peut matcher le
// préfixe "langue" de PROP_NAME (ci-dessus) avant "langues" en entier,
// laissant un "s" résiduel non reconnu — bug réel rencontré en écrivant
// cette règle (voir aussi le commentaire sur `chart_value`/LALL plus haut
// pour la même famille de piège lexer).
LANGUES_KW.2: "langues" | "languages" | "idiomas" | "sprachen" | "lingue"

NAME: /[^\W\d]\w*/
STRING: /"[^"]*"/
NUMBER: /-?\d+(\.\d+)?/

COMMENT: /\/\/[^\n]*/

%import common.WS
%ignore WS
%ignore COMMENT
