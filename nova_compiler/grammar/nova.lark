// ============================================================================
// NOVA DSL grammar — multilingual business-intent language.
// Every block/type keyword exists in French, English, Spanish, German,
// Italian and Portuguese; every spelling compiles to the exact same AST
// node, so a .nova file can freely mix languages.
// ============================================================================

start: statement*

statement: app_decl
         | entity_decl
         | api_decl
         | page_decl
         | auth_decl
         | query_decl
         | chart_decl

// ---------------------------------------------------------------- app -----
// Optional single block describing the application itself.
app_decl: APP_KW NAME "{" app_prop* "}"
app_prop: PROP_NAME ":" value

// ------------------------------------------------------------- entity -----
entity_decl: ENTITY_KW NAME "{" entity_member* "}"
entity_member: field_decl
             | relation_decl
field_decl: FIELD_KW NAME ":" type_ref modifier*
modifier: REQUIRED_KW
        | UNIQUE_KW
        | DEFAULT_KW "=" value
        | PATTERN_KW "=" STRING
type_ref: TYPE_STRING
        | TYPE_TEXT
        | TYPE_INT
        | TYPE_FLOAT
        | TYPE_BOOL
        | TYPE_DATE
        | TYPE_DATETIME
        | TYPE_FILE
        | TYPE_IMAGE
        | TYPE_COLOR
        | NAME                 // reference to another entity (relation by field)
relation_decl: HAS_MANY_KW NAME
             | BELONGS_TO_KW NAME

// ---------------------------------------------------------------- api -----
api_decl: API_KW NAME "{" api_member* "}"
api_member: api_action
          | protect_stmt
api_action: LIST_KW | CREATE_KW | UPDATE_KW | DELETE_KW | GET_KW
protect_stmt: PROTECT_KW ":" NAME

// --------------------------------------------------------------- page -----
page_decl: PAGE_KW NAME "{" page_stmt* "}"
page_stmt: SHOW_KW NAME (AS_KW display_mode)? (TITLE_KW STRING)? style_block?
display_mode: TABLE_KW | FORM_KW | CARD_KW
style_block: STYLE_KW "{" style_prop* "}"
style_prop: NAME ":" STRING

// --------------------------------------------------------------- auth -----
// Bloc optionnel unique : active l'authentification JWT + rôles pour tout
// le projet généré (backend + page de connexion Reflex).
auth_decl: AUTH_KW "{" auth_prop* "}"
auth_prop: ROLES_KW ":" name_list
         | DEFAULT_ROLE_KW ":" NAME
name_list: NAME ("," NAME)*

// -------------------------------------------------------------- query -----
// Requête déclarative au-delà du CRUD simple : filtre/tri/limite sur une
// entité, compilée en une route API dédiée (pas de SQL à écrire pour les
// cas courants).
query_decl: QUERY_KW NAME SUR_KW NAME "{" query_prop* "}"
query_prop: FILTRE_KW ":" NAME COMPARATOR value
          | TRIER_KW ":" NAME (ASC_KW | DESC_KW)?
          | LIMITE_KW ":" NUMBER

value: STRING | NUMBER | BOOL_TRUE | BOOL_FALSE | NAME

// -------------------------------------------------------------- chart -----
// Graphique déclaratif : `sur <NAME>` référence soit une entité (les
// données viennent alors de son API liste), soit un bloc `requete`/`query`
// déjà déclaré (données filtrées/triées) — résolu au moment de la
// génération, pas ici. Les propriétés (`type`, `axe_x`, `axe_y`, `titre`)
// sont des NAME libres résolues via `keywords.CHART_PROP_ALIASES`, comme le
// bloc `style`, plutôt que des mots-clés dédiés dans la grammaire.
// NB : `chart_prop` utilise volontairement un non-terminal dédié
// (`chart_value`) plutôt que le `value` générique utilisé par app_prop/
// query_prop : le réutiliser ici créait un conflit LALR qui corrompait le
// lexer contextuel ailleurs dans la grammaire (ex. `app { description: "x" }`
// cessait de se parser) — bug réel rencontré et corrigé pendant le
// développement de ce bloc `chart`.
chart_decl: CHART_KW NAME SUR_KW NAME "{" chart_prop* "}"
chart_prop: NAME ":" chart_value
chart_value: STRING | NAME

// ================================================== multilingual terminals ===
APP_KW: "app" | "application" | "aplicacion" | "aplicación" | "anwendung" | "applicazione" | "aplicacao" | "aplicação"
ENTITY_KW: "entity" | "entité" | "entite" | "entidad" | "entitaet" | "entität" | "entita" | "entità" | "entidade"
FIELD_KW: "field" | "champ" | "campo" | "feld"
REQUIRED_KW: "required" | "requis" | "requerido" | "obligatorio" | "erforderlich" | "richiesto" | "obbligatorio" | "obrigatorio" | "obrigatório"
UNIQUE_KW: "unique" | "unico" | "único" | "eindeutig"
DEFAULT_KW: "default" | "defaut" | "défaut" | "par_defaut" | "par_défaut" | "predeterminado" | "por_defecto" | "standard" | "predefinito" | "padrao" | "padrão"
PATTERN_KW: "pattern" | "motif" | "regex" | "patron" | "patrón" | "muster" | "modello" | "formato"
HAS_MANY_KW: "has_many" | "possede_plusieurs" | "possède_plusieurs" | "tiene_muchos" | "hat_viele" | "ha_molti" | "tem_muitos"
BELONGS_TO_KW: "belongs_to" | "appartient_a" | "appartient_à" | "pertenece_a" | "gehoert_zu" | "gehört_zu" | "appartiene_a" | "pertence_a"

API_KW: "api"
LIST_KW: "list" | "liste" | "listar" | "lista" | "elenco" | "auflisten"
CREATE_KW: "create" | "creer" | "créer" | "crear" | "erstellen" | "creare" | "criar"
UPDATE_KW: "update" | "modifier" | "mettre_a_jour" | "mettre_à_jour" | "actualizar" | "aktualisieren" | "aggiornare" | "atualizar"
DELETE_KW: "delete" | "supprimer" | "eliminar" | "borrar" | "loeschen" | "löschen" | "eliminare" | "excluir"
GET_KW: "get" | "obtenir" | "lire" | "obtener" | "erhalten" | "holen" | "ottenere" | "obter"
PROTECT_KW: "proteger" | "protect" | "protéger" | "proteggere" | "schuetzen" | "schützen"

PAGE_KW: "page" | "pagina" | "página" | "seite"
SHOW_KW: "show" | "afficher" | "mostrar" | "zeigen" | "anzeigen" | "mostrare" | "exibir"
AS_KW: "as" | "comme" | "como" | "als" | "come"
TITLE_KW: "title" | "titre" | "titulo" | "título" | "titel" | "titolo"
TABLE_KW: "table" | "tabla" | "tabelle" | "tabella" | "tabela"
FORM_KW: "form" | "formulaire" | "formulario" | "formulário" | "formular" | "modulo"
CARD_KW: "card" | "carte" | "tarjeta" | "karte" | "scheda" | "cartao" | "cartão"
STYLE_KW: "style" | "css" | "estilo" | "stil" | "stile"

AUTH_KW: "auth" | "authentification" | "authentication" | "autenticacion" | "autenticación" | "authentifizierung" | "autenticazione" | "autenticacao" | "autenticação"
ROLES_KW: "roles" | "rôles" | "rollen" | "ruoli" | "papeis" | "papéis"
DEFAULT_ROLE_KW: "role_par_defaut" | "role_par_défaut" | "default_role" | "rol_por_defecto" | "standardrolle" | "ruolo_predefinito" | "papel_padrao" | "papel_padrão"

CHART_KW: "chart" | "graphique" | "grafico" | "gráfico" | "diagramm"

QUERY_KW: "requete" | "requête" | "query" | "consulta" | "abfrage" | "interrogazione"
SUR_KW: "sur" | "on" | "from" | "en" | "von" | "su" | "em"
FILTRE_KW: "filtre" | "filter" | "filtro"
TRIER_KW: "trier_par" | "sort_by" | "order_by" | "ordenar_por" | "sortieren_nach" | "ordina_per"
ASC_KW: "asc" | "croissant" | "ascendente" | "aufsteigend" | "crescente"
DESC_KW: "desc" | "décroissant" | "decroissant" | "descendente" | "absteigend" | "decrescente"
LIMITE_KW: "limite" | "limit" | "límite"
COMPARATOR: ">=" | "<=" | "==" | "!=" | ">" | "<"

TYPE_STRING: "string" | "chaine" | "chaîne" | "cadena" | "zeichenkette" | "stringa" | "cadeia"
TYPE_TEXT: "text" | "texte" | "texto" | "testo"
TYPE_INT: "int" | "integer" | "entier" | "entero" | "ganzzahl" | "intero" | "inteiro"
TYPE_FLOAT: "float" | "decimal" | "décimal" | "flotante" | "gleitkomma" | "decimale"
TYPE_BOOL: "bool" | "boolean" | "booleen" | "booléen" | "booleano" | "boolesch"
TYPE_DATE: "date" | "fecha" | "datum" | "data"
TYPE_DATETIME: "datetime" | "date_heure" | "fecha_hora" | "datum_zeit" | "data_ora" | "data_hora"
TYPE_FILE: "file" | "fichier" | "archivo" | "datei" | "arquivo"
TYPE_IMAGE: "image" | "imagen" | "bild" | "immagine" | "imagem"
TYPE_COLOR: "color" | "couleur" | "farbe" | "colore" | "cor"

BOOL_TRUE: "true" | "vrai" | "verdadero" | "wahr" | "vero" | "verdadeiro"
BOOL_FALSE: "false" | "faux" | "falso" | "falsch"

PROP_NAME: "name" | "nom" | "description" | "lang" | "langue" | "version"
         | "nombre" | "nome" | "descripcion" | "descripción" | "beschreibung" | "descrizione"
         | "descricao" | "descrição" | "idioma" | "lingua" | "sprache"
         | "css" | "feuille_style" | "stylesheet"

NAME: /[^\W\d]\w*/
STRING: /"[^"]*"/
NUMBER: /-?\d+(\.\d+)?/

COMMENT: /\/\/[^\n]*/

%import common.WS
%ignore WS
%ignore COMMENT
